# Shared secret – the same value goes into the Moodle plugin settings.
# Generate one with:  openssl rand -hex 32
MPL_RUNNER_SECRET=change-me-please-change-me
# Where the API listens on the host (use e.g. 10.0.0.5:8000 to bind to one interface)
MPL_RUNNER_BIND=8000
# Long-lived worker containers for test runs (= evaluations in parallel).
# Default: number of CPU cores (4–8).
# MPL_WORKERS=6
# Pre-started one-shot containers for the interactive console
MPL_POOL_SIZE=4
# Max. simultaneous interactive consoles
MPL_MAX_SESSIONS=40
# Defaults/caps for limits (teachers can change per activity within the caps)
MPL_TIMEOUT=30
MPL_MAX_TIMEOUT=120
MPL_MEMORY_MB=512
MPL_MAX_MEMORY_MB=1024
MPL_CPUS=1
# Console sessions: idle timeout / max lifetime in seconds
MPL_SESSION_IDLE=120
MPL_SESSION_MAX=600
# Optional: stronger isolation with gVisor (install runsc first)
# MPL_DOCKER_RUNTIME=runsc
