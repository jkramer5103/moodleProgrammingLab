 {
  "name": "3 · Caesar-Verschlüsselung",
  "intro": "<p>Implementiere <code>encrypt(text, shift)</code>: Jeder Kleinbuchstabe wird um <code>shift</code> Stellen im Alphabet verschoben (z → a). Andere Zeichen bleiben gleich.</p>",
  "starter": "def encrypt(text, shift):\n    # Dein Code hier\n    pass\n",
  "reference": "def encrypt(text, shift):\n    out = \"\"\n    for ch in text:\n        if 'a' <= ch <= 'z':\n            out += chr((ord(ch) - 97 + shift) % 26 + 97)\n        else:\n            out += ch\n    return out\n",
  "maxattempts": 5,
  "tests": [
   {
    "id": "abc",
    "name": "encrypt('abc', 1)",
    "type": "function",
    "function": "encrypt",
    "points": 2,
    "visibility": "visible",
    "inputs": [
     {
      "kind": "fixed",
      "value": "'abc'"
     },
     {
      "kind": "fixed",
      "value": "1"
     }
    ],
    "expected": {
     "source": "fixed",
     "value": "'bcd'"
    },
    "compare": {
     "mode": "exact"
    }
   },
