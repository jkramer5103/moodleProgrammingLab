    "function": "ausgeglichen",
    "points": 2,
    "visibility": "visible",
    "show_expected": "always",
    "repeat": 4,
    "inputs": [
     {
      "kind": "choice",
      "options": "')(', '([)]', '{(})', ']][['"
     }
    ],
    "expected": {
     "source": "reference"
    },
    "compare": {
     "mode": "exact"
    }
   },
   {
