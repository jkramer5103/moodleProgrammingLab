   {
    "id": "juni",
    "name": "Juni-Daten (wetter.csv)",
    "type": "io",
    "points": 4,
    "visibility": "visible",
    "show_expected": "always",
    "expected": {
     "source": "reference"
    },
    "compare": {
     "mode": "numbers",
     "tolerance": 0.051
    }
   },
   {
